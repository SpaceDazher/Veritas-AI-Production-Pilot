{
  "name": "veritas-ai-production-pilot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node tests/validate-pilot.mjs && node --test tests/*.test.mjs",
    "verify": "npm test",
    "discovery": "node bin/veritas-pilot.mjs discover",
    "probe:environment": "node scripts/probe-environment.mjs",
    "probe:auth": "node scripts/probe-agent-auth.mjs",
